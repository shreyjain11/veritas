{
  "schema_version": "2.0",
  "benchmark": {
    "adapter": "jsonl",
    "id": "veritas-open-weight-smoke",
    "version": "1",
    "path": "examples/benchmark_integrity/multiple_choice.jsonl",
    "visibility": "public",
    "task_type": "multiple_choice"
  },
  "model": {
    "id": "Qwen/Qwen2.5-0.5B-Instruct",
    "adapter": "huggingface_local",
    "open_weight": true,
    "generation": {
      "temperature": 0,
      "max_tokens": 8,
      "seed": 42
    },
    "request_limit": 100,
    "token_limit": 10000
  },
  "transformations": [
    {"type": "choice_permutation", "variants_per_item": 2},
    {"type": "choice_label_remap", "variants_per_item": 1},
    {"type": "formatting", "variants_per_item": 1}
  ],
  "detectors": [
    {"type": "perturbation"},
    {"type": "option_order"},
    {"type": "template_dependence"},
    {"type": "probability"}
  ],
  "runtime": {
    "seed": 42,
    "cache_dir": ".veritas/cache/open-weight-smoke"
  },
  "report": {
    "formats": ["json", "markdown", "html"],
    "include_item_level": true
  }
}
