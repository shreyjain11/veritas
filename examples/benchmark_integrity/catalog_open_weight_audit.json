{
  "schema_version": "2.0",
  "benchmark": {
    "adapter": "catalog",
    "name": "mmlu",
    "dataset_config": "all",
    "split": "test",
    "limit": 100,
    "streaming": true
  },
  "model": {
    "id": "Qwen/Qwen2.5-0.5B-Instruct",
    "adapter": "huggingface_local",
    "open_weight": true,
    "generation": {
      "temperature": 0,
      "max_tokens": 8,
      "seed": 42
    },
    "request_limit": 500,
    "token_limit": 10000
  },
  "transformations": [
    {"type": "choice_permutation", "variants_per_item": 2},
    {"type": "choice_label_remap", "variants_per_item": 1},
    {"type": "formatting", "variants_per_item": 1}
  ],
  "detectors": [
    {"type": "perturbation"},
    {"type": "option_order"},
    {"type": "template_dependence"},
    {"type": "probability"},
    {"type": "guided_completion"},
    {"type": "fresh_set"},
    {"type": "temporal"}
  ],
  "runtime": {
    "seed": 42,
    "cache_dir": ".veritas/cache/catalog-mmlu-qwen"
  }
}
