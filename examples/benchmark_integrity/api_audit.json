{
  "schema_version": "2.0",
  "benchmark": {
    "adapter": "catalog",
    "name": "mmlu",
    "limit": 100,
    "streaming": true
  },
  "model": {
    "id": "gpt-4o-mini",
    "adapter": "openai_compatible",
    "provider": "openai",
    "endpoint": "https://api.openai.com/v1",
    "generation": {
      "temperature": 0,
      "max_tokens": 16,
      "extra": {
        "api_key_env": "MODEL_API_KEY",
        "concurrency": 8
      }
    },
    "request_limit": 500,
    "token_limit": 10000
  },
  "transformations": [
    {"type": "choice_permutation", "variants_per_item": 1},
    {"type": "choice_label_remap", "variants_per_item": 1},
    {"type": "formatting", "variants_per_item": 1}
  ],
  "detectors": [
    {"type": "perturbation"},
    {"type": "option_order"},
    {"type": "template_dependence"}
  ],
  "runtime": {
    "seed": 42,
    "cache_dir": ".veritas/cache/api-mmlu"
  }
}
